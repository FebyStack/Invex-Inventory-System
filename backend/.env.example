# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# SMTP (optional — leave blank to disable email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notification scanner. 0 disables it. Default: 15 minutes.
NOTIF_SCAN_INTERVAL_MS=900000
