PORT=3000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Database: the team's shared Supabase project (docs/supabase-setup.md) ──
# Values come from Supabase: Project → Connect → Session pooler. The password is shared privately, never committed.
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.usnbvoxklowgfhanhjrr
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=certs/supabase-ca.crt
DB_POOL_MAX=3

# ── Or a local database instead (comment out the block above) ──
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=invex
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false

# On a shared database only ONE person (Febriel) runs the 15-minute alert scanner; everyone else keeps it off.
NOTIF_SCAN_INTERVAL_MS=0

# Optional email alerts; without these, alerts stay in the app.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
