# Dependencies
node_modules/

# Environment variables and secrets (never commit; share the DB password privately)
.env
.env.*
**/.env
**/.env.*
backend/.env
!.env.example
!backend/.env.example
*.pem
*.key
*.p12
# The Supabase CA certificate (backend/certs/supabase-ca.crt) is public and IS committed.

# Documentation stays local, never pushed (proposal, diagrams, setup guides)
docs/

# Database dumps (contain real data)
invex_supabase_*.sql
*.dump
*.backup

# Postman environments may contain credentials — keep out of git
postman/environments/*.environment.yaml
!postman/environments/*.example.yaml

# Uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*

# Build output
dist/
build/
